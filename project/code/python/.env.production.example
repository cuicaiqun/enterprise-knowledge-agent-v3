# Copy to .env.production and provide values through a secret manager in production.
APP_ENV=production
REQUIRE_STRONG_SECRETS=true

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
# Embeddings (required for ingest→QA). Chat ≠ embeddings.
# Pick ONE: openai (/embeddings on BASE_URL) | local (text2vec in image) | chroma (ONNX).
# If using a chat-only gateway, set local or chroma — do not leave openai against a 404 /embeddings.
EMBEDDING_BACKEND=chroma
EMBEDDING_MODEL=text-embedding-3-small

NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_READ_USER=
NEO4J_READ_PASSWORD=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=knowledge
JWT_SECRET=
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

VECTOR_STORE_TYPE=chroma
CHROMA_HOST=chromadb
CHROMA_PORT=8000
STATE_STORE_DSN=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/knowledge
PGVECTOR_DSN=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/knowledge
REDIS_URL=redis://redis:6379/0

AUTH_ENABLED=true
INGEST_QUEUE=arq
INGEST_ASYNC=true
UPDATE_MODE=kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
UPLOAD_AV_SCAN_ENABLED=true
UPLOAD_AV_SCAN_REQUIRED=true
