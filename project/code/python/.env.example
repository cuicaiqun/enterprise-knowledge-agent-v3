# LLM Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
# Embeddings — chat gateway ≠ embeddings. Pick ONE of:
#   (A) EMBEDDING_BACKEND=openai  — OPENAI_BASE_URL must serve working /embeddings
#   (B) EMBEDDING_BACKEND=local   — text2vec subprocess (needs torch/sentence-transformers image)
#   (C) EMBEDDING_BACKEND=chroma  — Chroma ONNX MiniLM (offline; no gateway embedding model)
# auto = deepseek URL → local, else openai; on construct/probe failure → chroma fallback.
# MVP: if OPENAI_BASE_URL is chat-only (Embeddings 404), set local or chroma — do not assume chat key implies embeddings.
# Runtime probes embeddings at startup/ingest; health → degraded and upload → 503 when unavailable.
EMBEDDING_BACKEND=auto

# Runtime (P0-3)
# development = allow demo defaults; production/prod OR REQUIRE_STRONG_SECRETS=true refuses weak secrets
APP_ENV=development
REQUIRE_STRONG_SECRETS=false

# Neo4j — required by compose (${NEO4J_PASSWORD:?...}); change for anything beyond local demo
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
# P0-5 optional read-only user (empty = queries reuse NEO4J_USER)
NEO4J_READ_USER=
NEO4J_READ_PASSWORD=

# Postgres password used by compose DSN wiring (must match STATE_STORE_DSN / PGVECTOR_DSN)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge

# Vector Store: chroma (default; connect to the Chroma HTTP service) | pgvector
VECTOR_STORE_TYPE=chroma
# When starting only the dependencies locally, keep localhost. Docker Compose
# overrides this to the chromadb service name for the API container.
CHROMA_HOST=localhost
CHROMA_PORT=8000

# PGVector (if VECTOR_STORE_TYPE=pgvector)
PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/knowledge

# State persistence + idempotency (P1-3). Empty = in-memory fallback.
# Local default: localhost:5432. Compose API uses host `postgres`.
# Compose publishes Postgres on host port 5433 if you use docker-compose.dev.yml.
STATE_STORE_DSN=postgresql://postgres:postgres@localhost:5432/knowledge

# Incremental updates: watchdog | kafka | off (watchdog watches UPLOAD_DIR by default)
UPDATE_MODE=watchdog
UPDATE_WATCH_DIRECTORY=

# Kafka (CDC)
# Containers: kafka:9092. Host (with docker-compose.dev.yml): localhost:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Empty → {KAFKA_TOPIC_DOC_CHANGES}.dlq
KAFKA_CDC_DLQ_TOPIC=
KAFKA_TOPIC_DOC_CHANGES=doc-changes

# API upload ↔ watchdog dual-run suppress window (seconds)
WATCH_SUPPRESS_SECONDS=45

# API
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO

# P0-0 upload security
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=52428800
UPLOAD_MAX_PDF_PAGES=100
UPLOAD_AV_SCAN_ENABLED=false
UPLOAD_AV_SCAN_REQUIRED=false

# Ingest async queue (P1-5).
# INGEST_QUEUE=local|arq|auto — default local (in-process). Use arq with Redis + ingest-worker.
# Host Redis (native) is often :6379; compose Redis is published as :6380 in docker-compose.dev.yml.
# Inside Docker network, api/worker use redis://redis:6379/0 (set by compose).
REDIS_URL=redis://localhost:6379/0
INGEST_QUEUE=local
INGEST_WORKERS=2
INGEST_ASYNC=true

# Auth / ACL (P1-1) — JWT OAuth2 password flow + document ACL
AUTH_ENABLED=true
AUTH_DB_PATH=./data/auth.db
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=admin123
AUTH_BOOTSTRAP_TENANT_ID=default

# P0-4 durable multi-turn QA checkpointer (sqlite file on disk / auth_data volume)
QA_CHECKPOINT_BACKEND=sqlite
QA_CHECKPOINT_PATH=./data/qa_checkpoints.sqlite

# P2 — LLM resilience / rate limit / entity alignment
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=2
REQUIRE_OPENAI_API_KEY=true
RATE_LIMIT_QA_PER_MINUTE=30
RATE_LIMIT_QA_PER_TENANT_PER_MINUTE=120
ENTITY_SIMILARITY_THRESHOLD=0.82
# Optional JSON alias map, e.g. {"腾讯公司":"腾讯"}
ENTITY_ALIAS_MAP=
